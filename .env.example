# Copy to .env.local (git-ignored) and fill in. Never commit real values.
VITE_ENCRYPTION_KEY=

# Optional overrides (defaults are in src/lib/smartx/config.ts)
# VITE_GATEWAY_PATH=/gateway/Interceptor
# VITE_API_DATE_FORMAT=yyyy-MM-dd     # yyyy-MM-dd | dd-MM-yyyy | dd/MM/yyyy | dd MMM yyyy
# VITE_ALL_MILK_CODE=                 # only if the portal has a single "all milk" milktype code

# Optional speed-up for farmer reports: one request for cow+buffalo (Z) instead of two (C,B). Test one search first.
# VITE_FARMER_MILK_CODES=Z,M   # default C,B,M

# Fallbacks, used ONLY when the login response carries no ids (comma separated)
# VITE_VLCC_IDS=
# VITE_STATION_ID=
# VITE_MCC_ID=709   # needed by VlccCollection (HTTP 500 without it)

# Development only: pre-fill the login form in `npm run dev` (ignored in production builds)
# VITE_DEV_EMAIL=
# VITE_DEV_PASSWORD=

# Optional: rate chart id for /home/FarmerMilkEntry (Farmerwise collection tab)
# VITE_RATE_ID=

# Name of the login-record column that is passed to getCenter (only if it is not called stationid / station / "...station...")
# VITE_CENTER_ID_FIELD=plantid

# 1 = left menu shows ONLY what getMenu returns (no extra pages under "More")
# VITE_MENU_ONLY=1
